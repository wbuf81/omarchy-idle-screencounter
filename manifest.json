{
  "schemaVersion": 1,
  "id": "io.github.wbuf81.idle-screencounter",
  "name": "Idle Screen Counter",
  "version": "2.1.0",
  "author": "Wes (wbuf81)",
  "license": "MIT",
  "description": "Five theme-aware flip-board countdowns before Omarchy starts the screensaver, with an arrivals board of your running coding agents.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Idle Screen Counter",
    "description": "Shows and configures a station-board countdown before the screensaver.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "enabled": true,
      "warningSeconds": 120,
      "screensaverSeconds": 600,
      "lockSeconds": 1200,
      "snapSeconds": 30,
      "placement": "center",
      "flipStyle": "random",
      "agentsBoard": true,
      "agentsExtra": ""
    },
    "schema": [
      {
        "key": "enabled",
        "type": "boolean",
        "label": "Countdown enabled",
        "defaultValue": true
      },
      {
        "key": "warningSeconds",
        "type": "integer",
        "label": "Show countdown after (seconds)",
        "min": 15,
        "max": 1800,
        "defaultValue": 120
      },
      {
        "key": "screensaverSeconds",
        "type": "integer",
        "label": "Start screensaver after (seconds)",
        "min": 30,
        "max": 1800,
        "defaultValue": 600
      },
      {
        "key": "lockSeconds",
        "type": "integer",
        "label": "Lock after (seconds)",
        "min": 45,
        "max": 3600,
        "defaultValue": 1200
      },
      {
        "key": "snapSeconds",
        "type": "integer",
        "label": "Slider snap (seconds)",
        "min": 15,
        "max": 60,
        "defaultValue": 30
      },
      {
        "key": "placement",
        "type": "string",
        "label": "Popup placement",
        "defaultValue": "center"
      },
      {
        "key": "flipStyle",
        "type": "string",
        "label": "Flip style (solari, bits, drum, sweep, step, random)",
        "defaultValue": "random"
      },
      {
        "key": "agentsBoard",
        "type": "boolean",
        "label": "Arrivals board (running coding agents)",
        "defaultValue": true
      },
      {
        "key": "agentsExtra",
        "type": "string",
        "label": "Extra agent process names (comma separated)",
        "defaultValue": ""
      }
    ]
  },
  "keywords": [
    "idle",
    "screensaver",
    "lock",
    "countdown",
    "retro",
    "split-flap",
    "vestaboard",
    "departure-board",
    "agents",
    "claude-code",
    "codex"
  ]
}
